{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logos/*.txt",
    "color": {
      "1": "38;2;126;156;216"
	}
  },
  "modules": [
    {
      "type": "custom",
      "key": " ",
      "keyWidth": 0,
      "format": "\u001b[38;2;114;113;105m──────────────────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "title",
      "outputColor": "38;2;220;215;186",
      "format": "{user-name} {home-dir}",
      "key": "\ue602 PRFIL \uf2bd ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "custom",
      "key": " ",
      "keyWidth": 0,
      "format": "\u001b[38;2;114;113;105m──────────────────────────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "cpu",
      "outputColor": "38;2;220;215;186",
      "format": "",
      "key": "\ue602 PROCS \uf4bc ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "gpu",
      "outputColor": "38;2;220;215;186",
      "format": "",
      "key": "\ue602 GRAPH \udb80\ude97 ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "memory",
      "outputColor": "38;2;220;215;186",
      "format": "",
      "key": "\ue602 MEMRY \uefc5 ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "custom",
      "key": " ",
      "keyWidth": 0,
      "format": "\u001b[38;2;114;113;105m──────────────────────────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "os",
      "outputColor": "38;2;220;215;186",
      "format": "{pretty-name}",
      "key": "\ue602 OPSYS \udb81\udc93 ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "custom",
      "key": " ",
      "keyWidth": 0,
      "format": "\u001b[38;2;114;113;105m──────────────────────────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "display",
      "outputColor": "38;2;220;215;186",
      "format": "{inch}\" {refresh-rate}Hz {width}x{height} {name}",
      "key": "\ue602 DISPY \udb80\udf79 ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "custom",
      "key": " ",
      "keyWidth": 0,
      "format": "\u001b[38;2;114;113;105m──────────────────────────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "shell",
      "outputColor": "38;2;220;215;186",
      "format": "{process-name} - {pretty-name}",
      "key": "\ue602 SHELL \ue691 ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "terminal",
      "outputColor": "38;2;220;215;186",
      "format": "{pretty-name}",
      "key": "\ue602 TRMAL \ue795 ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "terminalfont",
      "outputColor": "38;2;220;215;186",
      "format": "{name}",
      "key": "\ue602 TRFNT \uf031 ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "custom",
      "key": " ",
      "keyWidth": 0,
      "format": "\u001b[38;2;114;113;105m──────────────────────────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "disk",
      "outputColor": "38;2;220;215;186",
      "format": "",
      "key": "\ue602 DISKS \uf07b ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "custom",
      "key": " ",
      "keyWidth": 0,
      "format": "\u001b[38;2;114;113;105m──────────────────────────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "localip",
      "outputColor": "38;2;220;215;186",
      "format": "{ifname} {ipv4}",
      "key": "\ue602 IPADD \udb82\ude5f ",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "custom",
      "key": " ",
      "keyWidth": 0,
      "format": "\u001b[38;2;114;113;105m──────────────────────────────────────────────────────╯\u001b[0m"
    }
  ]
}
